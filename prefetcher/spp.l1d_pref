#include "cache.h"

// ---------------- Parameters ----------------
#define IT_SIZE 256 // IP table entries (direct mapped on IP)
#define SIG_BITS 8  // signature width, also log2(pattern table size)
#define PT_SIZE (1 << SIG_BITS)
#define SIG_MASK (PT_SIZE - 1)
// a 4KB page has 64 lines, so in-page strides fit in 7 bits
#define MAX_STRIDE 63
#define EPOCH 256 // prefetches issued per accuracy check

// IP table: one entry per load IP
// Each load instruction (IP) gets its own row, so a loop walking array A and
// another loop walking array B are tracked separately and don't confuse
// each other's strides.
struct ip_entry {
  uint64_t tag;     // upper IP bits, checks the row really belongs to this IP
  uint64_t last_cl; // last cache line accessed by this IP
  int stride;       // last stride seen
  int conf;         // uniform-stride confidence (0..3)
  int sig;          // signature = hash of recent strides
};

// Pattern table: signature -> next expected stride
// Shared by all IPs. It answers: "after this history of strides, what stride
// usually comes next?" This is what catches non-uniform patterns like
// (+1, +2, +2, +2, +3) repeating.
struct pt_entry {
  int stride;
  int conf; // 0..3
};

ip_entry it[IT_SIZE];
pt_entry pt[PT_SIZE];

int degree = 4; // how many prefetches per access, changed by the throttle
// accuracy checker: remembers recently prefetched lines (slot = line % 64).
// A demand access that matches a slot counts as a useful prefetch.
uint64_t filt[64];
uint64_t epoch_useful = 0; // useful prefetches in the current epoch
uint64_t epoch_issued = 0; // prefetches issued in the current epoch

// stats only, printed at the end
uint64_t uniform_pf = 0, pattern_pf = 0;

// Build the next signature from the old one and the newest stride.
// Shift left by 3 so older strides slowly fall off the top, then XOR the new
// stride into the bottom bits. With 8 bits this remembers roughly the last
// 3 strides.
// Example for the pattern (+1, +2, +2, +2, +3) repeating, once it settles:
//   sig 82 -(+2)-> 146 -(+3)-> 147 -(+1)-> 153 -(+2)-> 202 -(+2)-> 82 ...
// Five different signatures, one for each position in the pattern, so each
// one can map to exactly one "next stride" in the pattern table.
int next_sig(int sig, int stride) {
  return ((sig << 3) ^ (stride & 0x7F)) & SIG_MASK;
}

void CACHE::l1d_prefetcher_initialize() {
  std::cout << "------------------------------------------------" << std::endl;
  std::cout << "        Stride Pattern Prefetcher (SPP)         " << std::endl;
  std::cout << "------------------------------------------------" << std::endl;
}

void CACHE::l1d_prefetcher_operate(uint64_t addr, uint64_t ip,
                                   uint8_t cache_hit, uint8_t type,
                                   uint8_t critical_ip_flag) {
  // byte address -> cache line number (divide by 64)
  uint64_t cl = addr >> LOG2_BLOCK_SIZE;

  // Accuracy checker: did this demand access hit a line we prefetched?
  // If yes, count it as useful and clear the slot so it is not counted twice.
  if (filt[cl % 64] == cl) {
    filt[cl % 64] = 0;
    epoch_useful++;
  }

  // IP table lookup: low bits pick the row, the remaining bits are the tag
  ip_entry *e = &it[ip % IT_SIZE];
  uint64_t tag = ip / IT_SIZE;

  // new IP: allocate and wait for the next access
  // Why return? We need two accesses from the same IP to know a stride.
  // After the first access to line 10 we can't tell if the next will be
  // line 11, 15 or 100, so we only record it and prefetch nothing.
  if (e->tag != tag) {
    e->tag = tag;
    e->last_cl = cl;
    e->stride = 0;
    e->conf = 0;
    e->sig = 0;
    return;
  }

  // stride in cache lines, can be negative (walking an array backwards)
  int stride = (int)(cl - e->last_cl);
  // same line again: gives no new information, ignore it
  if (stride == 0)
    return;
  e->last_cl = cl;

  // stride jumps out of the page: pattern history is useless, restart it
  // We can never prefetch across a page anyway, so a stride this big is
  // useless, and it would only pollute the signature.
  if (stride > MAX_STRIDE || stride < -MAX_STRIDE) {
    e->stride = 0;
    e->conf = 0;
    e->sig = 0;
    return;
  }

  // train uniform-stride confidence
  // 2-bit saturating counter: same stride again -> conf up, different -> down.
  // Example strides: +2 +2 +2 +5 +2   gives conf: 1 2 3 2 3
  // so one odd access does not throw away a good stream.
  if (stride == e->stride) {
    if (e->conf < 3)
      e->conf++;
  } else if (e->conf > 0) {
    e->conf--;
  } else {
    e->stride = stride; // only replace the stride once confidence is gone
  }

  // train pattern table: old signature should have predicted this stride
  // Same counter idea as above, but for "signature -> next stride".
  // If the entry is already at confidence 0, it gets replaced by the new
  // stride.
  pt_entry *p = &pt[e->sig];
  if (p->stride == stride) {
    if (p->conf < 3)
      p->conf++;
  } else if (p->conf > 0) {
    p->conf--;
  } else {
    p->stride = stride;
    p->conf = 1;
  }
  // now add this stride to the history
  e->sig = next_sig(e->sig, stride);

  // accuracy checker: every EPOCH prefetches, rescale the degree
  // accuracy (%) -> degree
  //   75 or more  -> 8   (prefetches are working, be aggressive)
  //   50 - 74     -> 6
  //   25 - 49     -> 3
  //   below 25    -> 2   (mostly useless, don't pollute the cache)
  if (epoch_issued >= EPOCH) {
    uint64_t acc = epoch_useful * 100 / epoch_issued;
    if (acc >= 75)
      degree = 8;
    else if (acc >= 50)
      degree = 6;
    else if (acc >= 25)
      degree = 3;
    else
      degree = 2;
    // start a new epoch
    epoch_issued = 0;
    epoch_useful = 0;
  }

  // prefetch: uniform stride first, else walk the pattern table
  // Uniform mode (conf >= 2): next lines are cl + s, cl + 2s, cl + 3s ...
  // Pattern mode: look up the next stride for the current signature, move
  // forward by it, update the signature with that predicted stride, repeat.
  // Example: at line A with sig 147 (we just saw +3) and degree 4:
  //   pt[147] = +1 -> A+1,  pt[153] = +2 -> A+3,
  //   pt[202] = +2 -> A+5,  pt[82]  = +2 -> A+7
  bool uniform = e->conf >= 2;
  stride = e->stride;
  uint64_t pf_cl = cl; // predicted cache line, starts at the current one
  int sig = e->sig;
  for (int i = 0; i < degree; i++) {
    int s;
    if (uniform) {
      s = stride;
    } else {
      // pattern table is not sure (conf 0), stop instead of guessing
      if (pt[sig].conf < 1)
        break;
      s = pt[sig].stride;
      sig = next_sig(sig, s);
    }
    pf_cl += s;

    // stay inside the current page
    // compare page numbers (address / 4096) of the prefetch and the demand
    if ((pf_cl << LOG2_BLOCK_SIZE) >> LOG2_PAGE_SIZE != addr >> LOG2_PAGE_SIZE)
      break;

    // same rule as ip_stride: if the MSHR is less than half full, bring the
    // line into L1, otherwise only into L2 so we don't block demand misses
    int fill = (MSHR.occupancy < (MSHR.SIZE >> 1)) ? FILL_L1 : FILL_L2;
    // prefetch_line returns 0 if the prefetch queue is full
    if (prefetch_line(ip, addr, pf_cl << LOG2_BLOCK_SIZE, fill, 0)) {
      epoch_issued++;
      filt[pf_cl % 64] = pf_cl; // remember it for the accuracy checker
      if (uniform)
        uniform_pf++;
      else
        pattern_pf++;
    }
  }
}

void CACHE::l1d_prefetcher_cache_fill(uint64_t v_addr, uint64_t addr,
                                      uint32_t set, uint32_t way,
                                      uint8_t prefetch, uint64_t v_evicted_addr,
                                      uint64_t evicted_addr,
                                      uint32_t metadata_in) {
  return; // metadata_in;
}

void CACHE::l1d_prefetcher_final_stats() {
  // how many prefetches came from each mode, useful for the report
  std::cout << "SPP uniform prefetches: " << uniform_pf
            << " pattern prefetches: " << pattern_pf
            << " final degree: " << degree << std::endl;
}
