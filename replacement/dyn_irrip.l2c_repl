#include "cache.h"

#define maxRRPV 3

// 0 = plain dynamic I-RRIP (Task 2B), 1 = also prefetch-aware (Task 3)
#define PF_AWARE 1

// Set-dueling counter: 10 bits, saturating
#define PSEL_BITS 8
#define PSEL_MAX  ((1 << PSEL_BITS) - 1)
// #define PSEL_MID  (1 << (PSEL_BITS - 1))
#define PSEL_MID 160

// PSEL training weights: an instruction demand miss moves PSEL more than a data demand miss
#define INSTR_MISS_WEIGHT 1
#define DATA_MISS_WEIGHT  1

uint32_t l2_rrpv[L2C_SET][L2C_WAY];
uint8_t  l2_is_instr[L2C_SET][L2C_WAY]; // line was brought in / touched by an instruction fetch
uint8_t  l2_is_pf[L2C_SET][L2C_WAY];    // line was filled by a (data) prefetch and not yet demanded

uint16_t l2_psel;

// PSEL low  -> I-RRIP is doing better (fewer misses in its leader sets)
// PSEL high -> plain RRIP is doing better
inline int l2_follower_policy() {
    return (l2_psel < PSEL_MID) ? 1 : 0;
}

// 1 = I-RRIP leader, 2 = RRIP leader, 0 = follower
inline int l2_role(uint32_t set) {
    uint8_t low = set & 31;
    uint8_t high = (set >> 5) & 31;

    if (low == high) return 1; // Classify them as I-RRIP set
    if (low == ((~high) & 31)) return 2; // Classify them as RRIP set
    return 0; // It is now a follower set
}

inline int l2_use_irrip(uint32_t set) {
    int role = l2_role(set);

    if (role == 1) return 1;
    if (role == 2) return 0;
    return l2_follower_policy();
}

// initialize replacement state
void CACHE::l2c_initialize_replacement()
{
    cout << "Initialize Dynamic I-RRIP state for L2C" << endl;

    l2_psel = PSEL_MID;

    for (int i = 0; i < L2C_SET; i++) {
        for (int j = 0; j < L2C_WAY; j++) {
            l2_rrpv[i][j] = maxRRPV;
            l2_is_instr[i][j] = 0; // Set the Initial values to Zeros
            l2_is_pf[i][j] = 0;
        }
    }
}

// find replacement victim
uint32_t CACHE::l2c_find_victim(uint32_t cpu, uint64_t instr_id, uint32_t set, const BLOCK *current_set, uint64_t ip, uint64_t full_addr, uint32_t type)
{
    for (int i = 0; i < L2C_WAY; i++) {
        if (!current_set[i].valid)
            return i;
    }

    int irrip = l2_use_irrip(set);
    // look for the maxRRPV line
    while (1)
    {
        int8_t instr_candidate = -1;

        for (int i = 0; i < L2C_WAY; i++) {
            if (l2_rrpv[set][i] == maxRRPV) {
                if (!irrip)
                    return i; // Do the RRIP part first

                if (!l2_is_instr[set][i])
                    return i; // Return i if it is data line

                if (instr_candidate < 0)
                    instr_candidate = i; // Remember this line in case there is no data line in set
            }
        }

        // only instruction lines are at max RRPV: evict one of them
        if (instr_candidate >= 0)
            return instr_candidate; // Evict the Instruction Line if no data line is evicted

        for (int i = 0; i < L2C_WAY; i++)
            l2_rrpv[set][i]++;
    }

    assert(0);
    return 0;
}

// called on every cache hit and cache fill
void CACHE::l2c_update_replacement_state(uint32_t cpu, uint32_t set, uint32_t way, uint64_t full_addr, uint64_t ip, uint64_t victim_addr, uint32_t type, uint8_t hit, uint8_t isInstruction)
{
    if ((type == WRITEBACK) && ip)
        assert(0);

    int is_instr  = (isInstruction && (type == LOAD || type == PREFETCH)) ? 1 : 0;
    int is_pf     = (type == PREFETCH && !is_instr) ? 1 : 0;   // data prefetch
    int is_demand = (type == LOAD || type == RFO) ? 1 : 0;

    int role  = l2_role(set);
    int irrip = l2_use_irrip(set);

    // PSEL training: demand misses in the leader sets
    if (!hit && role != 0 && is_demand) {
        int w = (is_instr && type == LOAD) ? INSTR_MISS_WEIGHT : DATA_MISS_WEIGHT;

        if (role == 1)
            l2_psel = (l2_psel + w > PSEL_MAX) ? PSEL_MAX : l2_psel + w;   // I-RRIP leader missed: up
        else
            l2_psel = (l2_psel > w) ? l2_psel - w : 0;                     // RRIP leader missed: down
    }

    if (hit) {
#if PF_AWARE
        // A prefetch hitting an existing line is not evidence of reuse
        if (type == PREFETCH)
            return;

        // First demand touch of a prefetched line: it was useful
        if (is_demand)
            l2_is_pf[set][way] = 0;
#endif
        if (is_instr)
            l2_is_instr[set][way] = 1;

        l2_rrpv[set][way] = 0;
    } else {
        l2_is_instr[set][way] = is_instr;
        l2_is_pf[set][way] = is_pf;

        uint32_t ins = maxRRPV - 1;

        if (irrip && is_instr)
            ins = (PF_AWARE && type != LOAD) ? 1 : 0; // demand instruction fetch: 0; instruction prefetch: 1 (only when PF-aware)
        else if (PF_AWARE && is_pf)
            ins = maxRRPV;                  // data prefetch: distant, evicted first unless demanded

        l2_rrpv[set][way] = ins;
    }
}

